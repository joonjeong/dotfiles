{{- $hostname := .chezmoi.hostname -}}
{{- $username := .chezmoi.username -}}
{{- $is_work := or (eq $hostname "work-laptop") (hasPrefix "work-" $hostname) -}}
{{- $is_personal := not $is_work -}}

# Chezmoi configuration template
# This file is processed as a template to generate .chezmoi.toml

[data]
    # User information
    name = "{{ env "FULL_NAME" | default "Your Name" }}"
    username = "{{ $username }}"
    hostname = "{{ $hostname }}"

{{- if $is_work }}
    # Work environment configuration
    email = "{{ env "WORK_EMAIL" | default "work@company.com" }}"
    signing_key = "{{ env "WORK_GPG_KEY" | default "WORK_KEY_ID" }}"

    [data.work]
        username = "{{ env "WORK_USERNAME" | default $username }}"
        email = "{{ env "WORK_EMAIL" | default "work@company.com" }}"
        server = "{{ env "WORK_SERVER" | default "work-server.company.com" }}"
        signing_key = "{{ env "WORK_GPG_KEY" | default "WORK_KEY_ID" }}"

    [data.proxy]
        http = "{{ env "HTTP_PROXY" | default "http://proxy.company.com:8080" }}"
        https = "{{ env "HTTPS_PROXY" | default "http://proxy.company.com:8080" }}"
        host = "{{ env "PROXY_HOST" | default "proxy.company.com" }}"
        port = {{ env "PROXY_PORT" | default "8080" }}

{{- else }}
    # Personal environment configuration
    email = "{{ env "PERSONAL_EMAIL" | default "personal@example.com" }}"
    signing_key = "{{ env "PERSONAL_GPG_KEY" | default "PERSONAL_KEY_ID" }}"

    [data.personal]
        email = "{{ env "PERSONAL_EMAIL" | default "personal@example.com" }}"
        github_username = "{{ env "GITHUB_USERNAME" | default "your_github" }}"
        signing_key = "{{ env "PERSONAL_GPG_KEY" | default "PERSONAL_KEY_ID" }}"

{{- end }}

# Operating system specific configuration
{{- if eq .chezmoi.os "darwin" }}
    [data.homebrew]
        prefix = "/opt/homebrew"

    [data.os]
        type = "macos"
        package_manager = "brew"

{{- else if eq .chezmoi.os "linux" }}
    [data.homebrew]
        prefix = "/home/linuxbrew/.linuxbrew"

    [data.os]
        type = "linux"
        package_manager = "apt"

{{- else if eq .chezmoi.os "windows" }}
    [data.os]
        type = "windows"
        package_manager = "choco"
{{- end }}

# Architecture specific settings
[data.arch]
    type = "{{ .chezmoi.arch }}"
{{- if eq .chezmoi.arch "arm64" }}
    is_arm = true
{{- else }}
    is_arm = false
{{- end }}

# Development tools configuration
[data.development]
    editor = "{{ env "EDITOR" | default "nvim" }}"
    shell = "{{ env "SHELL" | default "/bin/bash" }}"
    terminal = "{{ env "TERM" | default "xterm-256color" }}"

# Package lists
[data.packages]
    # Common packages for all systems
    common = [
        "git",
        "nvim",
        "tmux",
        "curl",
        "wget",
        "jq"
    ]

{{- if eq .chezmoi.os "darwin" }}
    # macOS specific packages
    macos = [
        "brew",
        "mas",
        "rectangle",
        "alfred"
    ]
{{- end }}

{{- if eq .chezmoi.os "linux" }}
    # Linux specific packages
    linux = [
        "apt-transport-https",
        "ca-certificates",
        "gnupg",
        "lsb-release"
    ]
{{- end }}

{{- if $is_work }}
    # Work environment packages
    work = [
        "docker",
        "kubectl",
        "terraform",
        "awscli",
        "azure-cli"
    ]
{{- end }}

{{- if $is_personal }}
    # Personal environment packages
    personal = [
        "youtube-dl",
        "ffmpeg",
        "imagemagick"
    ]
{{- end }}

# Git configuration
[data.git]
    name = "{{ .data.name }}"
    email = "{{ .data.email }}"
    signing_key = "{{ .data.signing_key }}"

{{- if $is_work }}
    # Work-specific git settings
    work_email = "{{ .data.work.email }}"
    work_signing_key = "{{ .data.work.signing_key }}"
{{- end }}

# SSH configuration
[data.ssh]
{{- if $is_work }}
    # Work SSH configuration
    work_key = "~/.ssh/id_rsa_work"
    work_host = "{{ .data.work.server }}"
{{- end }}
{{- if $is_personal }}
    # Personal SSH configuration
    personal_key = "~/.ssh/id_ed25519"
    github_key = "~/.ssh/id_ed25519"
{{- end }}

# Application preferences
[data.apps]
    # Editor configuration
    editor = "{{ .data.development.editor }}"

    # Terminal configuration
    shell = "{{ .data.development.shell }}"
    terminal = "{{ .data.development.terminal }}"

    # Browser
    browser = "{{ env "BROWSER" | default "firefox" }}"

# Feature flags and toggles
[data.features]
    # Enable/disable certain features
    use_encryption = true
    auto_push = {{ env "CHEZMOI_AUTO_PUSH" | default "false" }}
    backup_enabled = true

{{- if $is_work }}
    # Work-specific features
    use_proxy = true
    use_vpn = true
    corporate_compliance = true
{{- else }}
    # Personal features
    use_proxy = false
    use_vpn = false
    corporate_compliance = false
{{- end }}

# Path configurations
[data.paths]
    home = "{{ .chezmoi.homeDir }}"
    config = "{{ .chezmoi.homeDir }}/.config"
    bin = "{{ .chezmoi.homeDir }}/.local/bin"

{{- if eq .chezmoi.os "darwin" }}
    applications = "/Applications"
    homebrew = "{{ .data.homebrew.prefix }}"
{{- else if eq .chezmoi.os "linux" }}
    applications = "{{ .chezmoi.homeDir }}/.local/share/applications"
    homebrew = "{{ .data.homebrew.prefix }}"
{{- end }}

# Encryption configuration
encryption = "age"

[age]
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
    # Replace with your actual age public key
    recipient = "{{ env "CHEZMOI_AGE_RECIPIENT" | default "age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9aqmcac8p" }}"

# Git configuration for the dotfiles repository
[git]
    autoPush = {{ .data.features.auto_push }}
    autoCommit = false

# Merge tool configuration
[merge]
    command = "{{ .data.development.editor }}"
    args = ["-d", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Source {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]

# Template options
[template]
    options = ["missingkey=error"]

# Difference tool configuration
[diff]
    command = "{{ env "DIFFTOOL" | default "diff" }}"
    args = ["-u", "{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]

# Script execution configuration
[scriptEnv]
    CHEZMOI_OS = "{{ .chezmoi.os }}"
    CHEZMOI_ARCH = "{{ .chezmoi.arch }}"
    CHEZMOI_HOSTNAME = "{{ .chezmoi.hostname }}"
    IS_WORK = "{{ $is_work }}"
    IS_PERSONAL = "{{ $is_personal }}"